# =====================================================================
# BIN SALEH Store — Backend Environment Template
# Copy this file to `.env` and fill in your real values.
# NEVER commit your real `.env` (it is gitignored).
# =====================================================================

# ---- Server ----
PORT=5000
NODE_ENV=development            # production on Vercel/Render

# ---- MongoDB Atlas (keep credentials here, never in code) ----
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/binsaleh?retryWrites=true&w=majority

# ---- Auth secrets (use long random strings; set on every host) ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Optional overrides (defaults are derived from JWT_SECRET):
# JWT_REFRESH_SECRET=...
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_DAYS=30

# ---- Admin setup key (register-admin) ----
ADMIN_SETUP_KEY=change_this_setup_key

# ---- Admin approval bypass (comma-separated owner emails) ----
# ADMIN_APPROVAL_BYPASS_EMAILS=owner@example.com

# ---- CORS (frontend origin; comma not needed — single origin) ----
CLIENT_URL=http://localhost:5500
# API_URL=https://your-api.example.com

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- SMTP / email ----
SMTP_EMAIL=yourapp@gmail.com
SMTP_PASSWORD=your_app_password

# ---- Optional security tunables (defaults are secure) ----
# SESSION_IDLE_DAYS=14
# SESSION_MAX_DAYS=30
# MAX_FAILED_ATTEMPTS=5
# AUTH_RATE_LIMIT_MAX=15
# PASSWORD_MIN_LENGTH=8
